{
  "type": "object",
  "properties": {
    "broker_type": {
      "type": "string",
      "enum": [
        "mt5",
        "stock",
        "crypto",
        "other"
      ]
    },
    "broker_name": {
      "type": "string"
    },
    "account_label": {
      "type": "string"
    },
    "account_masked": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "demo",
        "live"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "disconnected",
        "connecting",
        "connected",
        "error",
        "disabled"
      ]
    },
    "backend_connection_id": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "balance": {
      "type": "number"
    },
    "equity": {
      "type": "number"
    },
    "last_sync": {
      "type": "string"
    },
    "trading_enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "broker_type",
    "environment",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "name": "BrokerAccount"
}