{
  "name": "GoldReaperConfig",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "default": "XAUUSD"
    },
    "timeframe": {
      "type": "string",
      "default": "H1"
    },
    "min_account_balance": {
      "type": "number",
      "default": 600
    },
    "show_info_panel": {
      "type": "boolean",
      "default": true
    },
    "infopanel_size": {
      "type": "number",
      "default": 1
    },
    "update_infopanel_during_testing": {
      "type": "boolean",
      "default": false
    },
    "trade_frequency": {
      "type": "string",
      "enum": [
        "auto",
        "very_conservative",
        "conservative",
        "normal",
        "aggressive",
        "extreme",
        "startlots"
      ],
      "default": "auto"
    },
    "maximum_allowed_spread": {
      "type": "number",
      "default": 30
    },
    "friday_stop_hour": {
      "type": "number",
      "default": 25
    },
    "set_sl_tp_after_entry": {
      "type": "boolean",
      "default": false
    },
    "use_virtual_expiration": {
      "type": "boolean",
      "default": false
    },
    "randomization": {
      "type": "number",
      "default": 50
    },
    "base_magic_number": {
      "type": "integer",
      "default": 20240001
    },
    "trade_comment": {
      "type": "string",
      "default": "GoldReaper"
    },
    "lotsize_calc_method": {
      "type": "string",
      "enum": [
        "fixed_startlots",
        "max_drawdown"
      ],
      "default": "max_drawdown"
    },
    "start_lots": {
      "type": "number",
      "default": 0.01
    },
    "max_allowed_drawdown": {
      "type": "number",
      "default": 20
    },
    "max_daily_drawdown": {
      "type": "number",
      "default": 5
    },
    "use_equity_instead_of_balance": {
      "type": "boolean",
      "default": false
    },
    "only_up": {
      "type": "boolean",
      "default": false
    },
    "enable_nfp_filter": {
      "type": "boolean",
      "default": true
    },
    "auto_gmt": {
      "type": "boolean",
      "default": true
    },
    "gmt_offset_winter": {
      "type": "number",
      "default": 0
    },
    "gmt_offset_summer": {
      "type": "number",
      "default": 0
    },
    "nfp_close_open_trades": {
      "type": "boolean",
      "default": true
    },
    "nfp_close_pending_orders": {
      "type": "boolean",
      "default": true
    },
    "nfp_minutes_before": {
      "type": "number",
      "default": 30
    },
    "nfp_minutes_after": {
      "type": "number",
      "default": 60
    }
  },
  "required": [
    "symbol",
    "timeframe",
    "trade_frequency",
    "lotsize_calc_method"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}